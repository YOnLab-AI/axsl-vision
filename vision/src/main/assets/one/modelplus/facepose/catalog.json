  "pipelineContracts": {
    "faceDetection": "BlazeFace boxes are the selected detections. Actual YuNet five-point alignment is matched by box IoU before SFace128D embeddings. Unmatched detections retain no embedding. Existing ML Kit supplies optional attributes. No mouth corners are synthesized from BlazeFace six points.",
    "driver": "Largest face; 468 or 478 actual landmark network outputs. Eye aspect ratio (EAR), inner lip gap / mouth width, geometric solvePnP angles. EAR < 0.18 is the app geometric eye-closure criterion; no learned eye-open probability is fabricated.",
    "poseNet": "COCO17 -> existing ML Kit33 ID mapping, heatmap argmax + Y/X offsets, true sigmoid heatmap confidence, stride 32, unused joints omitted.",
    "blazePose": "Published pose detector + full landmark weights; first 33 landmarks, confidence is min(sigmoid(visibility), sigmoid(presence)), global model pose probability gate 0.5; no fabricated joint likelihood.",
    "execution": "Existing CPU thread setting; bounded input/output buffers, SHA-256 verified assets, per-owner close and cancellation; no date/license-time gate."
  },
